  <worksheets>
    <worksheet name='Day of week analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='sugar_cosmetics_instagram_data. (sugar_cosmetics_instagram_data)' name='federated.0uudyhg1jd17sb1f0vm7y1ukc18g' />
          </datasources>
          <datasource-dependencies datasource='federated.0uudyhg1jd17sb1f0vm7y1ukc18g'>
            <column caption='Total engagement' datatype='integer' name='[Calculation_0598694009962501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Likes]) + SUM([Comments]) + SUM([Shares]) + SUM([Saves])' />
            </column>
            <column caption='Avg engagement rate ' datatype='real' name='[Calculation_0598694010822663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0598694009962501] / SUM([Reach])) * 100' />
            </column>
            <column caption='Day of the week ' datatype='string' name='[Calculation_0598694063800330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Post Date])' />
            </column>
            <column datatype='integer' name='[Comments]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Likes]' role='measure' type='quantitative' />
            <column datatype='date' name='[Post Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Reach]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Saves]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Shares]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0598694063800330]' derivation='None' name='[none:Calculation_0598694063800330:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0598694010822663]' derivation='User' name='[usr:Calculation_0598694010822663:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
