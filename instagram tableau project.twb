      <column caption='Total post' datatype='integer' name='[Calculation_0598694006595585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([Post Type])' />
      </column>
      <column caption='total likes' datatype='integer' name='[Calculation_0598694008172546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Likes])' />
      </column>
      <column caption='Total comments' datatype='integer' name='[Calculation_0598694009085955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Comments])' />
      </column>
      <column caption='Total reach' datatype='integer' name='[Calculation_0598694009397252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Reach])' />
      </column>
      <column caption='Total engagement' datatype='integer' name='[Calculation_0598694009962501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Likes]) + SUM([Comments]) + SUM([Shares]) + SUM([Saves])' />
      </column>
      <column caption='Avg engagement rate ' datatype='real' name='[Calculation_0598694010822663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0598694009962501] / SUM([Reach])) * 100' />
      </column>
      <column caption='Post month' datatype='datetime' name='[Calculation_0598694016815112]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Post Date])' />
      </column>
      <column caption='Post key' datatype='string' name='[Calculation_0598694026735625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Post Date]) + &quot;-&quot; + [Post Type]' />
      </column>
      <column caption='Day of the week ' datatype='string' name='[Calculation_0598694063800330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Post Date])' />
      </column>
      <column caption='overall performance' datatype='integer' name='[Calculation_0598694070464523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Likes]) + SUM([Comments]) + SUM([Shares]) + SUM([Saves])+ sum([Reach])+ SUM([Impressions]))' />
      </column>
